<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Todo Application</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body>
    <div class="grid grid-cols-6">
      <div class="col-start-3 col-span-2">
        <h1 class="text-2xl font-semibold text-gray-600">My Todo-list</h1>
        
        <form id="todo-form">
  <div class="flex gap-2 py-4">
    <div class="flex-auto w-64">
      <input
        id="todo-title"
        name="title"
        type="text"
        class="border border-gray-300 text-gray-900 text-sm rounded w-full p-2"
        placeholder="What's next?"
        autofocus
        required
      />
    </div>

    <div class="flex-auto w-32">
      <input
        id="todo-date"
        name="dueDate"
        type="date"
        class="border border-gray-300 text-gray-900 text-sm rounded w-full p-2 leading-4"
        required
      />
    </div>

    <div class="flex-none">
      <button
        type="submit"
        class="text-white bg-green-600 hover:bg-green-700 font-medium rounded text-sm px-5 py-2"
      >
        Add
      </button>
    </div>
  </div>
</form>

        <h5 class="text-gray-700 font-medium mt-4">
          Overdue (<%= overdue.length %>)
        </h5>

        <%- include("todos.ejs", { todos: overdue }) %>

        <h5 class="text-gray-700 font-medium mt-4">
          Due Today (<%= dueToday.length %>)
        </h5>

        <%- include("todos.ejs", { todos: dueToday }) %>

        <h5 class="text-gray-700 font-medium mt-4">
          Due Later (<%= dueLater.length %>)
        </h5>

        <%- include("todos.ejs", { todos: dueLater }) %>
      </div>
    </div>
  </body>
  <script>
  document
    .getElementById("todo-form")
    .addEventListener("submit", async function (event) {
      event.preventDefault();

      const titleInput = document.getElementById("todo-title");
      const dateInput = document.getElementById("todo-date");

      const title = titleInput.value.trim();
      const dueDate = dateInput.value;

      if (!title) {
        alert("Please enter a todo title");
        titleInput.focus();
        return;
      }

      if (!dueDate) {
        alert("Please select a due date");
        dateInput.focus();
        return;
      }

      const tokenResponse = await fetch("/csrf-token");
const { csrfToken } = await tokenResponse.json();

const response = await fetch("/todos", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "CSRF-Token": csrfToken,
  },
  body: JSON.stringify({
    title: title,
    dueDate: dueDate,
  }),
});

      if (response.ok) {
        window.location.reload();
      } else {
        const result = await response.json();
        alert(result.error || "Failed to create todo");
      }
    });
</script>
</html>
